{
  "name": "agentic-ai-academy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "predev": "node scripts/prepare-python.mjs",
    "prebuild": "node scripts/prepare-python.mjs && node scripts/build-metadata.mjs",
    "test:content": "node --experimental-strip-types scripts/validate-content.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-python": "^6.2.0",
    "@codemirror/language": "^6.13.1",
    "@codemirror/theme-one-dark": "^6.1.2",
    "@codemirror/view": "^6.43.14",
    "codemirror": "^6.0.1",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "pyodide": "0.28.3",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.0"
  }
}
